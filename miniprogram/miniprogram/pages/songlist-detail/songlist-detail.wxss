.songlist-detail {
  padding: 32rpx 24rpx 0;
}
.head {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}
.cover {
  width: 220rpx;
  height: 220rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.cover.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: var(--text-muted);
}
.head-info { flex: 1; min-width: 0; }
.name { font-size: 36rpx; font-weight: 600; color: var(--text-primary); }
.meta { font-size: 24rpx; color: var(--text-secondary); margin-top: 8rpx; }
.desc { font-size: 24rpx; color: var(--text-muted); margin-top: 8rpx; }
.btn-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-play {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 24rpx;
}
.btn-play:active { background: var(--brand-primary-hover); }
.btn-like {
  padding: 14rpx 28rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-subtle);
  color: var(--text-secondary);
  font-size: 24rpx;
}
.btn-like.liked { background: #f3e3ea; color: #ea2261; }

.list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.bottom-space { height: 120rpx; }
