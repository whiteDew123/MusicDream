.song-detail {
  padding: 32rpx 24rpx 0;
}
.song-head {
  display: flex;
  gap: 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}
.cover {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-subtle);
  flex-shrink: 0;
}
.cover.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  color: var(--text-muted);
}
.head-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.name { font-size: 36rpx; font-weight: 600; color: var(--text-primary); }
.singer { font-size: 26rpx; color: var(--text-secondary); margin-top: 10rpx; }
.stats { font-size: 22rpx; color: var(--text-muted); margin-top: 16rpx; }

.action-row {
  display: flex;
  justify-content: space-around;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 16rpx;
  margin-top: 24rpx;
  box-shadow: var(--shadow-card);
}
.act-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: inherit;
}
.act-icon { font-size: 44rpx; color: var(--text-secondary); }
.act-icon.liked { color: #ea2261; }
.act-label { font-size: 22rpx; color: var(--text-muted); }

.comment-section { margin-top: 32rpx; }
.section-title { font-size: 32rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 20rpx; }
.comment-input-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.comment-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  padding: 0 28rpx;
  font-size: 26rpx;
  box-shadow: var(--shadow-card);
}
.input-ph { color: var(--text-muted); }
.comment-submit {
  width: 120rpx;
  height: 72rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.comment-submit:active { background: var(--brand-primary-hover); }

.comment-list { background: var(--bg-card); border-radius: var(--radius-lg); box-shadow: var(--shadow-card); }
.comment-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--brand-primary-soft);
  color: var(--brand-primary-hover);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.comment-body { flex: 1; min-width: 0; }
.comment-user { font-size: 24rpx; color: var(--text-secondary); }
.comment-content { font-size: 28rpx; color: var(--text-primary); margin-top: 6rpx; line-height: 1.5; }
.comment-time { font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; }
.bottom-space { height: 120rpx; }
