.register-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #f0f4f8 0%, #e2e8f0 100%);
  padding: 100rpx 48rpx;
  display: flex;
  justify-content: center;
}
.form-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  padding: 48rpx 40rpx;
  align-self: flex-start;
}
.input-group {
  margin-bottom: 32rpx;
}
.input {
  height: 88rpx;
  background: #f1f4f9;
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.input:focus { border-color: var(--brand-primary); }
.input-ph { color: var(--text-muted); }
.code-row {
  display: flex;
  gap: 16rpx;
}
.code-input { flex: 1; }
.code-btn {
  width: 200rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  background: var(--brand-primary-soft);
  color: var(--brand-primary-hover);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.code-btn:disabled { opacity: 0.6; }
.btn-primary {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary:active { background: var(--brand-primary-hover); }
