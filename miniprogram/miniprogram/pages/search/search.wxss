.search-page {
  padding: 24rpx 24rpx 0;
}
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: var(--shadow-card);
}
.search-icon { font-size: 28rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.input-ph { color: var(--text-muted); }
.clear-btn {
  color: var(--text-muted);
  font-size: 36rpx;
  padding: 0 8rpx;
}
.search-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 40rpx 8rpx 20rpx;
}
.history-title { font-size: 28rpx; font-weight: 600; color: var(--text-primary); }
.history-clear { font-size: 24rpx; color: var(--text-muted); }
.history-wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.history-chip {
  padding: 12rpx 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.result-header { margin: 32rpx 8rpx 16rpx; }
.result-title { font-size: 26rpx; color: var(--text-secondary); }
.result-skeleton { height: 320rpx; }
.result-list {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.bottom-space { height: 120rpx; }
