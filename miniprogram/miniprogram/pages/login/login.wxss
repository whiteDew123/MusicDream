/* 登录页（Design-standards 登录页专用微调规则：浅蓝灰渐变背景 + 白色卡片 + 紫色按钮） */
.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #f0f4f8 0%, #e2e8f0 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx;
}
.brand {
  text-align: center;
  margin-bottom: 80rpx;
}
.logo {
  font-size: 88rpx;
}
.brand-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}
.brand-slogan {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.form-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  padding: 48rpx 40rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-primary:active {
  background: var(--brand-primary-hover);
}
.btn-wx {
  margin-bottom: 8rpx;
}
.wx-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  font-size: 26rpx;
  margin-right: 12rpx;
}

.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 40rpx 0;
  position: relative;
}
.divider::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 1rpx;
  background: var(--hairline);
}
.divider-text {
  position: relative;
  z-index: 1;
  background: var(--bg-card);
  padding: 0 24rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.input-group {
  margin-bottom: 32rpx;
}
.input {
  height: 88rpx;
  background: #f1f4f9;
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.input:focus {
  border-color: var(--brand-primary);
}
.input-ph {
  color: var(--text-muted);
}

.footer {
  text-align: center;
  margin-top: 32rpx;
}
.footer-text {
  font-size: 24rpx;
  color: var(--brand-primary);
}
