<view class="login-page">
  <view class="brand">
    <view class="logo">🎵</view>
    <view class="brand-title">MusicDreamer</view>
    <view class="brand-slogan">让音乐流动</view>
  </view>

  <view class="form-card">
    <!-- 微信一键登录 -->
    <button class="btn-primary btn-wx" bindtap="onWxLogin">
      <text class="wx-icon">微</text> 微信一键登录
    </button>

    <view class="divider"><text class="divider-text">或使用账号登录</text></view>

    <view class="input-group">
      <input
        class="input"
        placeholder="邮箱 / 用户名 / 手机号"
        placeholder-class="input-ph"
        value="{{account}}"
        bindinput="onAccount"
      />
      <input
        class="input"
        type="password"
        placeholder="密码"
        placeholder-class="input-ph"
        value="{{password}}"
        bindinput="onPassword"
      />
    </view>

    <button class="btn-primary" loading="{{loading}}" bindtap="onLogin">登 录</button>

    <view class="footer">
      <text class="footer-text" bindtap="goRegister">没有账号？去注册</text>
    </view>
  </view>
</view>
