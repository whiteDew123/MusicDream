.settings-page { padding: 32rpx 24rpx 60rpx; }
.section { margin-bottom: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 16rpx; padding: 0 8rpx; }
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}
.avatar-row { display: flex; align-items: center; gap: 24rpx; margin-bottom: 8rpx; }
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.avatar-edit {
  font-size: 26rpx;
  color: var(--brand-primary);
}
.field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); }
.label { width: 140rpx; font-size: 26rpx; color: var(--text-secondary); }
.input { flex: 1; font-size: 26rpx; color: var(--text-primary); }
.btn-save {
  margin-top: 32rpx;
  height: 80rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-save:active { background: var(--brand-primary-hover); }
