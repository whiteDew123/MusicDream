<view class="settings-page">
  <!-- 基本资料 -->
  <view class="section">
    <view class="section-title">基本资料</view>
    <view class="card">
      <view class="avatar-row">
        <image wx:if="{{avatar}}" class="avatar" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar fallback">{{ userInfo.username[0] }}</view>
        <view class="avatar-edit" bindtap="onChangeAvatar">更换头像</view>
      </view>
      <view class="field">
        <text class="label">用户名</text>
        <input class="input" value="{{username}}" data-field="username" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">邮箱</text>
        <input class="input" value="{{email}}" data-field="email" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" value="{{phone}}" data-field="phone" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">签名</text>
        <input class="input" value="{{about}}" data-field="about" bindinput="onField" />
      </view>
      <button class="btn-save" loading="{{saving}}" bindtap="onSaveInfo">保存</button>
    </view>
  </view>

  <!-- 修改密码 -->
  <view class="section">
    <view class="section-title">修改密码</view>
    <view class="card">
      <view class="field">
        <text class="label">旧密码</text>
        <input class="input" type="password" value="{{oldPassword}}" data-field="oldPassword" bindinput="onField" placeholder="请输入旧密码" />
      </view>
      <view class="field">
        <text class="label">新密码</text>
        <input class="input" type="password" value="{{newPassword}}" data-field="newPassword" bindinput="onField" placeholder="请输入新密码" />
      </view>
      <button class="btn-save" loading="{{savingPwd}}" bindtap="onSavePassword">修改密码</button>
    </view>
  </view>
</view>
