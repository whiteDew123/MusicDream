.favorite-page { padding: 24rpx 24rpx 0; }
.grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.playlist-card { width: calc(50% - 12rpx); }
.playlist-cover {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-subtle);
}
.playlist-cover.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: var(--text-muted);
}
.playlist-name { font-size: 28rpx; color: var(--text-primary); margin-top: 12rpx; line-height: 1.4; }
.playlist-author { font-size: 22rpx; color: var(--text-muted); margin-top: 4rpx; }
.bottom-space { height: 120rpx; }
