.my-page {
  padding: 32rpx 24rpx 0;
  min-height: 100vh;
  background: var(--bg-page);
}

/* 未登录 */
.login-cta {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cta-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  box-shadow: var(--shadow-card);
}
.cta-text { font-size: 28rpx; color: var(--text-secondary); margin: 32rpx 0; }
.btn-login {
  width: 400rpx;
  height: 84rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-login:active { background: var(--brand-primary-hover); }

/* 已登录 */
.profile-card {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--brand-primary-soft);
}
.avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #fff;
  background: var(--brand-primary);
}
.profile-info { margin-left: 24rpx; }
.username { font-size: 36rpx; font-weight: 600; color: var(--text-primary); }
.role-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  background: var(--brand-primary-soft);
  color: var(--brand-primary-hover);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
}

.menu-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.menu-item:active { background: var(--bg-subtle); }
.menu-icon { font-size: 36rpx; margin-right: 20rpx; color: var(--brand-primary); }
.menu-text { flex: 1; font-size: 28rpx; color: var(--text-primary); }
.menu-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: var(--radius-pill);
  background: #ea2261;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
}
.menu-arrow { color: var(--text-muted); font-size: 32rpx; }

.btn-logout {
  margin-top: 40rpx;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  color: #ea2261;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-card);
}
.bottom-space { height: 120rpx; }
