.created-page { padding: 32rpx 24rpx 0; }
.top-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28rpx; padding: 0 8rpx; }
.page-title { font-size: 40rpx; font-weight: 600; color: var(--text-primary); }
.btn-new {
  padding: 12rpx 24rpx;
  background: var(--brand-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
}
.grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.playlist-card { width: calc(50% - 12rpx); }
.playlist-cover {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: var(--bg-subtle);
}
.playlist-cover.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  color: var(--text-muted);
}
.playlist-name { font-size: 28rpx; color: var(--text-primary); margin-top: 12rpx; line-height: 1.4; }
.bottom-space { height: 120rpx; }
