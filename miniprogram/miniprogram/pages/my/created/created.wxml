<view class="created-page">
  <view class="top-row">
    <view class="page-title">我创建的歌单</view>
    <view class="btn-new" bindtap="onCreate">＋ 新建</view>
  </view>

  <view class="grid">
    <view wx:for="{{lists}}" wx:key="id" class="playlist-card" data-id="{{item.id}}" bindtap="onPlaylistTap">
      <image wx:if="{{item.pic}}" class="playlist-cover" src="{{item.pic}}" mode="aspectFill" lazy-load />
      <view wx:else class="playlist-cover fallback">♪</view>
      <view class="playlist-name clamp-2">{{item.name}}</view>
    </view>
    <empty-state wx:if="{{!loading && !lists.length}}" text="还没有创建歌单，点右上角新建" />
  </view>

  <view class="bottom-space"></view>
  <mini-player />
</view>
