/**app.wxss —— 全局样式 + 设计 Token（对齐 design-stripe / Design-standards 亮色系）**/

/* 设计 Token（CSS 变量，页面/组件统一引用，禁止裸值） */
page {
  /* 品牌色（应用端统一） */
  --brand-primary: #5e5ce6;
  --brand-primary-hover: #4a3fcf;
  --brand-primary-soft: #b9b9f9;

  /* 亮色基底 */
  --bg-page: #f6f9fc;
  --bg-card: #ffffff;
  --bg-subtle: #f0f4f8;
  --bg-skeleton: #e8ecf0;

  /* 文字 */
  --text-primary: #1a1a1a;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;

  /* 描边 / 阴影 */
  --hairline: #e3e8ee;
  --hairline-input: #a8c3de;
  --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.06);
  --shadow-hover: 0 4px 20px rgba(0, 0, 0, 0.08);

  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-pill: 9999px;

  --space-2: 2px;
  --space-4: 4px;
  --space-8: 8px;
  --space-12: 12px;
  --space-16: 16px;
  --space-24: 24px;
  --space-32: 32px;

  background: var(--bg-page);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 基础 reset */
view, text, scroll-view, image, button, input, textarea {
  box-sizing: border-box;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  border: none;
  line-height: inherit;
  font-size: inherit;
}
button::after {
  border: none;
}
button:focus {
  outline: 0;
}

/* 通用块 */
.container {
  padding: var(--space-16);
}
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  padding: var(--space-16);
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 多行省略 */
.clamp-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 骨架屏脉冲（animation.md 第三章） */
@keyframes skeletonPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}
.skeleton {
  background: var(--bg-skeleton);
  animation: skeletonPulse 1.2s infinite ease-in-out;
  border-radius: var(--radius-sm);
}

/* 页面切换淡入淡出 */
.page-fade {
  animation: pageFade 250ms ease-out;
}
@keyframes pageFade {
  from { opacity: 0; }
  to { opacity: 1; }
}
