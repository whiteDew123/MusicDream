/* 歌曲行组件（align animation.md 列表项交互：悬停变暗、当前项左侧紫色竖条） */
.song-item {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  position: relative;
  transition: background 150ms ease;
}
.song-item:active {
  background: var(--bg-subtle);
}
.song-item.is-active {
  background: var(--bg-subtle);
}
.song-item.is-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  border-radius: var(--radius-pill);
  background: var(--brand-primary);
  animation: barIn 200ms ease-out;
}
@keyframes barIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.rank-num {
  width: 44rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}
.rank-num.top {
  color: var(--brand-primary);
  font-weight: 600;
}

.cover {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx 0 8rpx;
  flex-shrink: 0;
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-fallback {
  font-size: 40rpx;
  color: var(--text-muted);
}
.playing-badge {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-primary);
  border: 4rpx solid #fff;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  overflow: hidden;
}
.name {
  font-size: 28rpx;
  color: var(--text-primary);
}
.singer {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.plays {
  font-size: 22rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  margin-right: 16rpx;
}
.duration {
  font-size: 22rpx;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  margin-right: 16rpx;
}

.more {
  display: flex;
  align-items: center;
  padding: 12rpx;
}
.more-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--text-muted);
  margin: 0 3rpx;
}
